{
  // Config para YaDominios Cloud. El archivo _worker.js (nombre mágico) corre
  // como worker; aquí solo declaramos los assets para que env.ASSETS quede
  // enlazado a ./public y el worker pueda servir los estáticos.
  // env.DB lo inyecta YaDominios automáticamente.
  "name": "harinadonpedro",
  "compatibility_date": "2026-07-01",
  "assets": { "directory": "./public", "binding": "ASSETS" }
}
