{
  // Config para YaDominios Cloud (patrón worker + assets, como OpenNext).
  // El worker (server.js) atiende /datos y /media; los estáticos salen de ./public.
  // env.DB y env.ASSETS los inyecta YaDominios. nodejs_compat como en el ejemplo oficial.
  "name": "harinadonpedro",
  "main": "server.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
