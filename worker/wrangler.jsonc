{
  // Config del worker para YaDominios Cloud.
  // El worker corre PRIMERO en cada petición: atiende la API (/datos, /media)
  // y para el resto sirve los estáticos de ./public vía env.ASSETS.
  // env.DB lo inyecta YaDominios automáticamente.
  "name": "harinadonpedro",
  "main": "server.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
